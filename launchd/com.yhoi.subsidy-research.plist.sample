<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  毎日 6:30 JST に調査を実行する launchd 定義のサンプル。
  Discordへの通知はGitHub Actions側（毎週月曜）が担当する。
  __REPO_DIR__ をこのリポジトリの絶対パスに置換してから
  ~/Library/LaunchAgents/ へ配置する。手順は README を参照。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yhoi.subsidy-research</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__REPO_DIR__/scripts/run-research.sh</string>
	</array>

	<!-- 毎日。システムのタイムゾーンで解釈される -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<!-- 読み込み時には走らせない（起動のたびに調査が動くのを防ぐ） -->
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>__REPO_DIR__/logs/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO_DIR__/logs/launchd-stderr.log</string>
</dict>
</plist>
